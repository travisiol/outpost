# Copy to .env.local. Every value below has a working default, so the app runs
# with no env at all — these are the things that must be set before it points
# at anything real.

# Canonical origin. Metadata and OG tags resolve against it.
NEXT_PUBLIC_SITE_URL=https://payport.example

# Robinhood Chain.
#
# The defaults in src/lib/chain.ts are third-party research, not official
# documentation. A live probe on 2026-09-01 confirmed that
# https://rpc.mainnet.chain.robinhood.com answers eth_chainId with 0x1237
# (4663), which matches — but re-confirm against https://docs.robinhood.com/chain
# before this touches real funds. A wrong chain id means the wallet signs for a
# network nobody is watching; a wrong RPC means balances read as zero on a
# funded account.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Optional links. Both stay hidden until set, so an unset value ships a missing
# button rather than a dead one.
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_X_URL=
